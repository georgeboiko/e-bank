{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-bank.local/schemas/kafka/fraud-check-requested-v1.schema.json",
  "title": "FraudCheckRequested v1",
  "description": "Transfer fraud check requested by Money from Antifraud.",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "data"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7 generated once when the Outbox record is created."
    },
    "eventType": {
      "const": "FraudCheckRequested"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "transferId",
        "fromAccountId",
        "toAccountId",
        "senderId",
        "recipientId",
        "amount",
        "deviceId",
        "ipAddress",
        "createdAt"
      ],
      "properties": {
        "transferId": {
          "$ref": "#/$defs/entityId"
        },
        "fromAccountId": {
          "$ref": "#/$defs/entityId"
        },
        "toAccountId": {
          "$ref": "#/$defs/entityId"
        },
        "senderId": {
          "$ref": "#/$defs/userId"
        },
        "recipientId": {
          "$ref": "#/$defs/userId"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0\\.(0[1-9]|[1-9][0-9])|[1-9][0-9]{0,16}\\.[0-9]{2})$",
          "description": "Positive RUB amount represented as numeric(19,2)."
        },
        "deviceId": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "ipAddress": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "format": "ipv4" },
            { "type": "string", "format": "ipv6" }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "entityId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Opaque Keycloak sub; UUID format is not required."
    }
  },
  "additionalProperties": true
}
