{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-bank.local/schemas/kafka/fraud-decision-v1.schema.json",
  "title": "FraudDecision v1",
  "description": "Final fraud decision published by Antifraud for Money. REVIEW_REQUIRED is never published.",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "data"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7 generated once when the Outbox record is created."
    },
    "eventType": {
      "const": "FraudDecision"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": ["transferId", "decision", "riskScore", "source", "triggeredRules"],
      "properties": {
        "transferId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "decision": {
          "type": "string",
          "enum": ["APPROVED", "REJECTED"]
        },
        "riskScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "source": {
          "type": "string",
          "enum": ["AUTOMATIC", "ANALYST"]
        },
        "triggeredRules": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Only TRIGGERED rule results. Empty when no rules were triggered.",
          "items": {
            "$ref": "#/$defs/triggeredRule"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "triggeredRule": {
      "type": "object",
      "required": ["ruleId", "score", "reason"],
      "properties": {
        "ruleId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
